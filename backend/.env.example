# Environment Settings for AffordAI Voice Co-Pilot Backend

PROJECT_NAME="AffordAI Voice Co-Pilot"
API_V1_STR="/api/v1"
SECRET_KEY="affordai-voice-copilot-super-secret-jwt-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL by default, falls back to SQLite if Postgres connection fails)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/affordai_db"
SQLITE_FALLBACK_URL="sqlite:///./affordai.db"

# AI Provider Credentials (Optional: Heuristic/Offline mode works automatically if API key is not provided)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-3.5-turbo"

# Directories
UPLOADS_DIR="../uploads"
KNOWLEDGE_BASE_DIR="../knowledge_base"
VECTOR_STORE_DIR="../vector_store"
